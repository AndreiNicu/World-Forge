// Kilo_Variants/kilo.glm-5.2.jsonc — ALL-SEATS GLM 5.2 variant of the shipped
// .kilo/kilo.jsonc, reasoning effort HIGH on every seat.
//
// ── How to use ───────────────────────────────────────────────────────────────
// Kilo only reads ./.kilo/kilo.jsonc (or the global config) — it does NOT load
// this folder. To activate: back up .kilo/kilo.jsonc, copy this file over it
// (keeping the name kilo.jsonc), and reload VS Code. The {file:...} prompt
// paths resolve relative to the config file's directory, so they are written
// for the .kilo/ location — do not run this file from Kilo_Variants/.
// Verify after switching: the WorldForge-* agents appear in the agent picker,
// and the OpenRouter activity dashboard shows requests landing on Z.AI.
//
// ── Same as the shipped config ───────────────────────────────────────────────
// The WorldForge-Orchestrator agent and every agent's "permission" block are
// identical to .kilo/kilo.jsonc (rationale in its header). Keep them in sync —
// only the model / temperature / routing fields differ between the files.
//
// ── What differs from the shipped (DeepSeek 4 Pro) config ────────────────────
// - Every seat runs "openrouter/z-ai/glm-5.2" (reasoning-class, 1M context).
// - No "temperature" fields anywhere: reasoner endpoints ignore sampling, so
//   the per-phase temperature table (wiki/Agentic-Tools-and-Models.md §3.5)
//   does not apply. Depth is controlled by reasoning effort instead.
// - Provider routing hard-pins the first-party Z.AI upstream ("only" — fails
//   loudly rather than falling back to the third-party hosts where the
//   reported mid-task stream failures live) and sets reasoning effort HIGH.
//   Effort is set per-MODEL here, so it applies to every seat; to give one
//   seat a different effort, add a per-agent passthrough field on that agent.
// - Cost note: HIGH effort on all seats — including the Compiler, whose
//   verbatim JSON transcription gains nothing from deep reasoning — is the
//   most expensive way to run the pipeline on GLM. Drop to "medium" if cost
//   bites. Run `python tools/validate_export.py Export/` after Phase 4 as
//   always.
{
  "$schema": "https://app.kilo.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": { "only": ["Z.AI"] },
            "reasoning": { "effort": "high" }
          }
        }
      }
    }
  },
  "agent": {
    // ── Orchestrator (select this agent, then type /worldforge ...) ──
    // Runs the router (workflows/world-forge.md): dispatches each phase to its
    // WorldForge-* agent, relays interactive agents' questions verbatim (router
    // → DISPATCH PROTOCOL rule 5), advances the Pipeline State Ledger, runs the read-only
    // validators. It cannot author phase content: its only writable file is the
    // Master Design (for the ledger), and it can dispatch only WorldForge-* agents.
    "WorldForge-Orchestrator": {
      "description": "Runs /worldforge commands — dispatches each phase to its WorldForge-* agent, relays interactive agents' questions verbatim, advances the Pipeline State Ledger, runs the read-only validators. Never authors phase content.",
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../workflows/world-forge.md}",
      "permission": {
        "read": "allow",
        "edit": { "*": "deny", "*Drafts/Master_Design.md": "allow" },
        "bash": {
          "*": "deny",
          "python tools/validate_export.py *": "allow",
          "py tools/validate_export.py *": "allow",
          "python tools/validate_pipeline_state.py *": "allow",
          "py tools/validate_pipeline_state.py *": "allow"
        },
        "task": { "*": "deny", "WorldForge-*": "allow" },
        "external_directory": "ask"
      }
    },
    // ── Ideation (optional, upstream of Phase 0) ──
    "WorldForge-Brainstormer": {
      "description": "Phase 0-pre (optional) — divergent ideation partner; helps a user with only a vibe find a premise, (adaptation posture, --adapt) extracts a playable world from an existing story/fanfiction/RP document, or (improvement posture standalone, --improve) ping-pongs improvement ideas against an existing world with no commitment, parking them in the standing Big_Brain_Storm.md. Writes informal Brainstorm_Notes.md (Big_Brain_Storm.md on standalone --improve); no World Seed.",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/Brainstormer/00_The_Brainstormer.md}",
      // Permissions: writes only its notes files.
      "permission": {
        "edit": { "*": "deny", "*Brainstorm_Notes.md": "allow", "*Big_Brain_Storm.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny",
        "external_directory": "ask"
      }
    },
    // ── Initial build (Phases 0–5) ──
    "WorldForge-Interviewer": {
      "description": "Phase 0 — interviews the user through the World Seed Template; creative partner, pushes back on thin material",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/00_The_Interviewer.md}",
      // Permissions: writes only the World Seed.
      "permission": {
        "edit": { "*": "deny", "*World_Seed.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny",
        "external_directory": "ask"
      }
    },
    "WorldForge-Refiner": {
      "description": "Phase 1 — classifies the World Seed into Tiers 1/2/3 and produces the locked Master Design",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/01_The_Refiner.md}",
      // Permissions: writes the Master Design (incl. the ledger it initializes) + its blocker file.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Master_Design.md": "allow", "*UNRESOLVED_QUESTIONS.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Architect": {
      "description": "Phase 2 — drafts all cards, persona, and Tier 1/2/3 lorebook content from the Master Design",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/02_The_Architect.md}",
      // Permissions: all drafts except the LOCKED Master Design and other agents' reports.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/*": "allow",
          "*Drafts/Master_Design.md": "deny",
          "*Drafts/Editor_Critique_*": "deny",
          "*Drafts/Voice_Audit_Report_*": "deny",
          "*Drafts/Arc_Transition_Audit_*": "deny",
          "*Drafts/Intimacy_Audit_Report_*": "deny",
          "*Drafts/Revision_R*": "deny",
          "*Drafts/Revise_R*": "deny",
          "*Drafts/Audition_*": "deny"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-IntimacyArchitect": {
      "description": "Phase 2.5 (conditional) — drafts Tier 2 intimacy profiles and Tier 3 intimacy registers",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/06_The_Intimacy_Architect.md}",
      // Permissions: intimacy profiles/registers + its blocker file only.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/Tier2_*Intimacy*": "allow",
          "*Drafts/Tier3_*Intimacy_Register.md": "allow",
          "*UNRESOLVED_INTIMACY.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    // Audit seats — GLM 5.2 carries no temperature (reasoners ignore sampling);
    // audit discipline comes from the HIGH reasoning effort in the provider block.
    "WorldForge-Editor": {
      "description": "Phase 3 — validates drafts against the hard-fail rules; read-only on drafts, writes critique reports",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/03_The_Editor.md}",
      // Permissions: read-only on drafts: writes only its critique (audit/apply separation, CLAUDE.md #3).
      "permission": {
        "edit": { "*": "deny", "*Drafts/Editor_Critique_*.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-VoiceAuditor": {
      "description": "Phase 3.5 — simulates dialogue and audits behavioral fidelity; read-only on drafts, writes audit reports",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/03b_The_Voice_Auditor.md}",
      // Permissions: read-only on drafts: writes only its report.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Voice_Audit_Report_*.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-ArcAuditor": {
      "description": "Phase 3.6 (arc mode only) — audits continuity across arc seams; read-only on drafts, writes audit reports",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/03c_The_Arc_Transition_Auditor.md}",
      // Permissions: read-only on drafts: writes only its report.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Arc_Transition_Audit_*.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-IntimacyAuditor": {
      "description": "Phase 3.7 (conditional) — audits intimate-scene fidelity and register; read-only on drafts, writes audit reports",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/03d_The_Intimacy_Auditor.md}",
      // Permissions: read-only on drafts: writes only its report.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Intimacy_Audit_Report_*.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Compiler": {
      "description": "Phase 4 — transcribes approved drafts to SillyTavern JSON verbatim; no sampling knob on a reasoner, so verify with tools/validate_export.py after every compile",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/04_The_Compiler.md}",
      // Permissions: the only Export/ JSON writer; never Drafts/ (fix the source, not the export).
      "permission": {
        "edit": { "*": "deny", "*Export/*": "allow" },
        "bash": {
          "*": "deny",
          "python *": "ask",
          "py *": "ask",
          "node *": "ask",
          "python tools/validate_export.py *": "allow",
          "py tools/validate_export.py *": "allow"
        },
        "task": "deny"
      }
    },
    "WorldForge-PromptEngineer": {
      "description": "Phase 5 — audits Export/ for runtime correctness and authors the Chat Completion Preset",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/05_The_Prompt_Engineer.md}",
      // Permissions: read-only on cards/lorebooks: writes only its audit, the preset, and its reports (CLAUDE.md #3/#8).
      "permission": {
        "edit": {
          "*": "deny",
          "*Export/Prompt_Engineer_Audit.md": "allow",
          "*Export/*_ChatPreset.json": "allow",
          "*Export/Authors_Note_Suggestions.md": "allow",
          "*Export/Preset_Resync_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    // ── Post-launch entry points ──
    "WorldForge-Reviser": {
      "description": "Phase R0 — classifies a post-launch revision request and routes it through the revise pipeline",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/00_The_Reviser.md}",
      // Permissions: writes the Revision Log entry + initializes the revision report.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Master_Design.md": "allow", "*Drafts/Revision_R*_Report.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    // The revise minis (agent_roles/revise/*) are defined here so WorldForge-Orchestrator
    // can dispatch them in order per workflows/world-forge-revise.md.
    "WorldForge-Refiner-mini": {
      "description": "Phase R1 — merges the revision delta into the canonical Master Design",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/01_The_Refiner_mini.md}",
      // Permissions: Master Design merge + revision report.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Master_Design.md": "allow", "*Drafts/Revision_R*_Report.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Architect-mini": {
      "description": "Phase R2 — drafts surgical edits/inserts to touched files within the cascade",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/02_The_Architect_mini.md}",
      // Permissions: drafts per cascade + Revision Log/report; never other agents' audit reports.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/*": "allow",
          "*Drafts/Editor_Critique_*": "deny",
          "*Drafts/Voice_Audit_Report_*": "deny",
          "*Drafts/Arc_Transition_Audit_*": "deny",
          "*Drafts/Intimacy_Audit_Report_*": "deny",
          "*Drafts/Revise_R*": "deny",
          "*Drafts/Audition_*": "deny"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-IntimacyArchitect-mini": {
      "description": "Phase R2.5 (conditional) — drafts surgical edits/inserts to touched intimacy files",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/02b_The_Intimacy_Architect_mini.md}",
      // Permissions: intimacy drafts per cascade + Revision Log/report.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/Tier2_*Intimacy*": "allow",
          "*Drafts/Tier3_*Intimacy_Register.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Editor-mini": {
      "description": "Phase R3 — validates touched files against the Editor's hard-fail rules",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/03_The_Editor_mini.md}",
      // Permissions: read-only on drafts: revision report + Revision Log status only.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Master_Design.md": "allow", "*Drafts/Revision_R*_Report.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-VoiceAuditor-mini": {
      "description": "Phase R3.5 — simulates dialogue and audits voice fidelity on touched files",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/03b_The_Voice_Auditor_mini.md}",
      // Permissions: read-only on drafts: its audit + revision report + Revision Log status.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/Revise_R*_Voice_Audit.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-ArcAuditor-mini": {
      "description": "Phase R3.6 — audits continuity on touched arc-seam neighbors",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/03c_The_Arc_Transition_Auditor_mini.md}",
      // Permissions: read-only on drafts: its audit + revision report + Revision Log status.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/Revise_R*_Arc_Transition_Audit.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-IntimacyAuditor-mini": {
      "description": "Phase R3.7 — audits intimate-scene fidelity on touched files",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/03d_The_Intimacy_Auditor_mini.md}",
      // Permissions: read-only on drafts: its audit + revision report + Revision Log status.
      "permission": {
        "edit": {
          "*": "deny",
          "*Drafts/Revise_R*_Intimacy_Audit.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Compiler-mini": {
      "description": "Phase R4 — compiles touched files and updates cumulative manifest",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/04_The_Compiler_mini.md}",
      // Permissions: touched Export/ files + REVISED_FILES.md + its compile log + revision report.
      "permission": {
        "edit": {
          "*": "deny",
          "*Export/*": "allow",
          "*Drafts/Revise_R*_Compile_Log.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": {
          "*": "deny",
          "python *": "ask",
          "py *": "ask",
          "node *": "ask",
          "python tools/validate_export.py *": "allow",
          "py tools/validate_export.py *": "allow"
        },
        "task": "deny"
      }
    },
    "WorldForge-PromptEngineer-mini": {
      "description": "Phase R5 — audits compile output and updates runtime preset",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/revise/05_The_Prompt_Engineer_mini.md}",
      // Permissions: the preset only on the Export side (narrow toggles) + its audit + revision report.
      "permission": {
        "edit": {
          "*": "deny",
          "*Export/*_ChatPreset.json": "allow",
          "*Drafts/Revise_R*_Prompt_Engineer_Audit.md": "allow",
          "*Drafts/Master_Design.md": "allow",
          "*Drafts/Revision_R*_Report.md": "allow"
        },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    },
    "WorldForge-Converter": {
      "description": "Phase C0 — reframes a shipped world into a new World Seed (protagonist / mode / tone changes), or rebaselines a revised world into a clean rebuild (--rebaseline)",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/Converter/00_The_Converter.md}",
      // Permissions: writes only the target World Seed; read-only on the source.
      "permission": {
        "edit": { "*": "deny", "*World_Seed.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny",
        "external_directory": "ask"
      }
    },
    "WorldForge-Auditioner": {
      "description": "On-demand behavioral probe (post-launch) — simulates one character in one user-supplied scene and returns YES/NO/IT DEPENDS with a spec trace; read-only, changes nothing",
      "mode": "all",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:../agent_roles/Auditioner/00_The_Auditioner.md}",
      // Permissions: read-only probe: writes only the optional --save record.
      "permission": {
        "edit": { "*": "deny", "*Drafts/Audition_*.md": "allow" },
        "bash": { "*": "deny", "python *": "ask", "py *": "ask", "node *": "ask" },
        "task": "deny"
      }
    }
  }
}
